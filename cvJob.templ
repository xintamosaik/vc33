package main

import (
	"net/http"
	"strconv"
)

var cvJob CVJob

func handleCVJobAdd(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.Atoi(r.PathValue("id"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	cv, found := findCV(id)
	if !found {
		http.NotFound(w, r)
		return
	}

    jobId, err := strconv.Atoi(r.PathValue("jobId"))
	if err != nil {
		http.NotFound(w, r)
		return
	}
    
    job, found := findJob(jobId)
	if !found {
		http.NotFound(w, r)
		return
	}

	page("Edit Job", cvJobAdd(cv.ID, job.ID)).Render(r.Context(), w)
}
func handleCVJobEdit(w http.ResponseWriter, r *http.Request) {
		id, err := strconv.Atoi(r.PathValue("id"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	cv, found := findCV(id)
	if !found {
		http.NotFound(w, r)
		return
	}

    jobId, err := strconv.Atoi(r.PathValue("jobId"))
	if err != nil {
		http.NotFound(w, r)
		return
	}
    
    job, found := findJob(jobId)
	if !found {
		http.NotFound(w, r)
		return
	}

	page("Edit Job", cvJobAdd(cv.ID, job.ID)).Render(r.Context(), w)
}

func handleCVJobUpdate(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.Atoi(r.PathValue("id"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	cv, found := findCV(id)
	if !found {
		http.NotFound(w, r)
		return
	}
	http.Redirect(w, r, "/cv/"+strconv.Itoa(cv.ID), http.StatusSeeOther)
}

templ cvJobAdd(id, jobId int) {
	<h1>Add { id }/{ jobId }</h1>
}

templ cvJobEdit() {
	<h1>Add</h1>
}

func init() {
	http.HandleFunc("GET /cv/{id}/job", handleCVJobAdd)
	http.HandleFunc("GET /cv/{id}/job/{jobId}", handleCVJobEdit)
	http.HandleFunc("POST /cv/{id}/job/{jobId}", handleCVJobUpdate)
}
