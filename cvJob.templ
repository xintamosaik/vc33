package main

import (
	"net/http"
	"strconv"
)

func handleCVJobAdd(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.Atoi(r.PathValue("id"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	cv, found := findCV(id)
	if !found {
		http.NotFound(w, r)
		return
	}

	jobId, err := strconv.Atoi(r.PathValue("jobId"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	job, found := findJob(jobId)
	if !found {
		http.NotFound(w, r)
		return
	}

	page("Edit Job", cvJobAdd(cv.ID, job)).Render(r.Context(), w)
}
func handleCVJobEdit(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.Atoi(r.PathValue("id"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	cv, found := findCV(id)
	if !found {
		http.NotFound(w, r)
		return
	}

	jobId, err := strconv.Atoi(r.PathValue("jobId"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	job, found := findJob(jobId)
	if !found {
		http.NotFound(w, r)
		return
	}

	page("Edit Job", cvJobAdd(cv.ID, job)).Render(r.Context(), w)
}

func handleCVJobUpdate(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.Atoi(r.PathValue("id"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	cv, found := findCV(id)
	if !found {
		http.NotFound(w, r)
		return
	}
	http.Redirect(w, r, "/cv/"+strconv.Itoa(cv.ID), http.StatusSeeOther)
}

templ cvJobAdd(id int, job Job) {
	<nav>
		<a href={ "/cv/" + strconv.Itoa(id) }>Back</a>
		<a href="/cvs">CVS</a>
		<a href="/">Profile</a>
	</nav>
	<h1>Add Job Details for CV { id } / Job { job.ID }</h1>
	<p>
		<span>{ job.Company } - { job.Title }</span> | <span>{ job.Location }</span>
	</p>
	<form action={ "/cv/" + strconv.Itoa(id) + "/job/" + strconv.Itoa(job.ID)} method="POST">
		<label>summary</label>
		<br/>
		<textarea>..</textarea>
		<br/>
		<button type="submit">Add</button>
	</form>
}

templ cvJobEdit() {
	<h1>Add</h1>
}

func init() {
	http.HandleFunc("GET /cv/{id}/job", handleCVJobAdd)
	http.HandleFunc("GET /cv/{id}/job/{jobId}", handleCVJobEdit)
	http.HandleFunc("POST /cv/{id}/job/{jobId}", handleCVJobUpdate)
}
