package main 

import "net/http"

var linkedin string = ""

func handleRequestUpdateLinkedIn(w http.ResponseWriter, r *http.Request) {
	if err := r.ParseForm(); err != nil {
		w.WriteHeader(http.StatusBadRequest)
		page("Edit LinkedIn", linkedinEdit(linkedin, "Could not read the form.")).Render(r.Context(), w)
		return
	}

	newlinkedin := r.FormValue("linkedin")
	if newlinkedin == "" {
		w.WriteHeader(http.StatusUnprocessableEntity)
		page("Edit LinkedIn", linkedinEdit("", "linkedin is required.")).Render(r.Context(), w)
		return
	}

	err :=writeString("linkedin.txt", newlinkedin)
	if err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		page("Edit LinkedIn", linkedinEdit("", "Could not save the linkedin.")).Render(r.Context(), w)
		return
	}

	linkedin = newlinkedin
	http.Redirect(w, r, "/", http.StatusSeeOther)
}

 
templ linkedinEdit(value string, err string) {
	<h1>Change linkedin?</h1>
	<form action="/linkedin" method="post">
		<label for="linkedin">linkedin</label>
		<input name="linkedin" id="linkedin" type="text" value={ value } required/>
		<button type="submit">Update</button>
	</form>
	if err != "" {
		<p role="alert">{ err }</p>
	}
	<a href="/">Cancel</a>
}

func handleLinkedInEdit(w http.ResponseWriter, r *http.Request) {
	page("Edit LinkedIn", linkedinEdit(linkedin, "")).Render(r.Context(), w)
}

templ linkedinEditLink() {
	<div>
		<span>LinkedIn: { linkedin }</span>
		<a href="/linkedin">[Edit]</a>
	</div>
}

func init() {
	saved, err := readString("linkedin.txt")
	if err == nil {
		linkedin = saved
	}

	http.HandleFunc("GET /linkedin", handleLinkedInEdit)
	http.HandleFunc("POST /linkedin", handleRequestUpdateLinkedIn)
}
