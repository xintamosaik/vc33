package main 

import (
	"encoding/json"
	"log"
	"net/http"
	"strconv"
	"strings"
)

type Education struct {
	ID          int       `json:"id"`
	Institution string    `json:"institution"`
	Location    string    `json:"location"`
	Degree      string    `json:"title"`
	Start       MonthDate `json:"start"`
	End         MonthDate `json:"end,omitzero"`
	Current     bool      `json:"current"`
}

var educations []Education

func nextEducationID() int {
	maxID := 0

	for _, education := range educations {
		if education.ID > maxID {
			maxID = education.ID
		}
	}

	return maxID + 1
}
func findEducation(id int) (Education, bool) {
	for _, education := range educations {
		if education.ID == id {
			return education, true
		}
	}

	return Education{}, false
}

func handleRequestUpdateEducation(w http.ResponseWriter, r *http.Request) {
	if err := r.ParseForm(); err != nil {
		w.WriteHeader(http.StatusBadRequest)
		page("Edit Education", educationEdit(Education{}, "Could not read the form.")).Render(r.Context(), w)
		return
	}

	next := Education{
		Institution: strings.TrimSpace(r.FormValue("institution")),
		Location:    strings.TrimSpace(r.FormValue("location")),
		Degree:      strings.TrimSpace(r.FormValue("title")),
		Current:     r.FormValue("current") != "",
	}

	// ID can be empty, we would need to deal with empty IDs (new entries)
	id := r.FormValue("id")
	if id != "" {
		ID, err := strconv.Atoi(id)
		if err != nil {
			w.WriteHeader(http.StatusUnprocessableEntity)
			page("Edit Education", educationEdit(next, "Invalid education ID.")).Render(r.Context(), w)
			return
		}
		next.ID = ID
	}

	// Institution needs to be filled. Even if the browser checks, we check again

	if next.Institution == "" {
		w.WriteHeader(http.StatusUnprocessableEntity)
		page("Edit Education", educationEdit(next, "Institution is required.")).Render(r.Context(), w)
		return
	}

	// Degree. Required. We double check it, too
	if next.Degree == "" {
		w.WriteHeader(http.StatusUnprocessableEntity)
		page("Edit Education", educationEdit(next, "Degree is required.")).Render(r.Context(), w)
		return
	}

	// Start Date as Month/Year. We validate it.
	start, err := parseMonthDate(
		r.FormValue("startMonth"),
		r.FormValue("startYear"),
	)
	if err != nil {
		w.WriteHeader(http.StatusUnprocessableEntity)
		page("Edit Education", educationEdit(next, err.Error())).Render(r.Context(), w)
		return
	}
	next.Start = start

	if !next.Current {
		end, err := parseMonthDate(
			r.FormValue("endMonth"),
			r.FormValue("endYear"),
		)
		if err != nil {
			w.WriteHeader(http.StatusUnprocessableEntity)
			page("Edit Education", educationEdit(next, err.Error())).Render(r.Context(), w)
			return
		}

		if end.Before(next.Start) {
			w.WriteHeader(http.StatusUnprocessableEntity)
			page("Edit Education", educationEdit(next, "Check your dates")).Render(r.Context(), w)
			return
		}
		next.End = end
	}

	nextEducations := append([]Education(nil), educations...)

	if next.ID == 0 {
		next.ID = nextEducationID()
		nextEducations = append(nextEducations, next)
	} else {
		found := false

		for i := range nextEducations {
			if nextEducations[i].ID == next.ID {
				nextEducations[i] = next
				found = true
				break
			}
		}

		if !found {
			w.WriteHeader(http.StatusNotFound)
			page("Edit Education", educationEdit(next, "Education not found.")).Render(r.Context(), w)
			return
		}
	}

	data, err := json.Marshal(nextEducations)
	if err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		page("Edit Education", educationEdit(next, "Could not encode the data.")).Render(r.Context(), w)
		return
	}

	err = writeString("educations.json", string(data))
	if err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		page("Edit Education", educationEdit(next, "Could not save the educations.")).Render(r.Context(), w)
		return
	}

	educations = nextEducations

	http.Redirect(w, r, "/", http.StatusSeeOther)
}

templ educationEdit(value Education, err string) {
	<h1>Change education?</h1>
	<form action="/education" method="post">
		if value.ID != 0 {
			<input
				type="hidden"
				name="id"
				value={ strconv.Itoa(value.ID) }
			/>
		}
		<label for="institution">Institution</label>
		<input
			name="institution"
			id="institution"
			value={ value.Institution }
			required
		/>
		<br/>
		<label for="title">Degree</label>
		<input
			name="title"
			id="title"
			value={ value.Degree }
			required
		/>
		<br/>
		<label for="location">Location</label>
		<input
			name="location"
			id="location"
			value={ value.Location }
		/>
		<br/>
		<label for="startMonth">Start month</label>
		<input
			name="startMonth"
			id="startMonth"
			type="number"
			min="1"
			max="12"
			value={ valueOrEmptyString(int(value.Start.Month)) }
			required
		/>
		<br/>
		<label for="startYear">Start year</label>
		<input
			name="startYear"
			id="startYear"
			type="number"
			min={ strconv.Itoa(earliestEducationYear()) }
			max={ strconv.Itoa(thisYear()) }
			value={ valueOrEmptyString(int(value.Start.Year)) }
			required
		/>
		<br/>
		<label>
			<input
				type="checkbox"
				name="current"
				checked?={ value.Current }
			/>
			Current education
		</label>
		<br/>
		<label for="endMonth">End month</label>
		<input
			name="endMonth"
			id="endMonth"
			type="number"
			min="1"
			max="12"
			value={ valueOrEmptyString(int(value.End.Month)) }
		/>
		<br/>
		<label for="endYear">End year</label>
		<input
			name="endYear"
			id="endYear"
			type="number"
			min={ strconv.Itoa(earliestEducationYear()) }
			max={ strconv.Itoa(thisYear()) }
			value={ valueOrEmptyString(int(value.End.Year)) }
		/>
		<br/>
		<button type="submit">Update</button>
	</form>
	if err != "" {
		<p role="alert">{ err }</p>
	}
	<a href="/">Cancel</a>
}

func handleEducationEdit(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.Atoi(r.PathValue("id"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	education, found := findEducation(id)
	if !found {
		http.NotFound(w, r)
		return
	}

	page("Edit Education", educationEdit(education, "")).Render(r.Context(), w)
}

func handleEducationAdd(w http.ResponseWriter, r *http.Request) {
	page("Add Education", educationEdit(Education{}, "")).Render(r.Context(), w)
}

templ EducationAddLink() {
	<a href="/education">[Add]</a>
}

templ educationList() {
	for _, education := range educations {
		@educationEditLink(education)
	}
}

templ educationEditLink(education Education) {
	<div>
		<span>{ education.Institution } - { education.Degree }</span>
		<a href={ "/education/" + strconv.Itoa(education.ID) }>[Edit]</a>
	</div>
}

func init() {
	saved, err := readString("educations.json")
	if err == nil {
		if err := json.Unmarshal([]byte(saved), &educations); err != nil {
			log.Println("There were errors reading educations data.")
		}
	}

	http.HandleFunc("GET /education", handleEducationAdd)
	http.HandleFunc("GET /education/{id}", handleEducationEdit)
	http.HandleFunc("POST /education", handleRequestUpdateEducation)
}
