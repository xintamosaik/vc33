package main

import "net/http"

templ home() {
	<h1>Home</h1>
	<nav>
		@userNameEditLink()
        @professionEditLink()
        @linkedinEditLink()
        <p>github/gitlab</p>
        @emailEditLink()
        <p>address</p>
        <p>jobs</p>
        <p>education</p>
        <p>skills</p>
        <p>projects</p>
	</nav>
}

func handleHome(w http.ResponseWriter, r *http.Request) {
	page("Home", home()).Render(r.Context(), w)
}

func init() {
    http.HandleFunc("/", handleHome)
}