package main
 
templ page(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ title }</title>
		</head>
		<body style="width: 60ch; margin: 0 auto;">
			@content
		</body>
	</html>
}
