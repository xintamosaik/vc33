package main

import (
	"encoding/json"
	"net/http"
	"strconv"
	"strings"
)

func findCVSkillCategory(cv CV, skillCategoryID int) (CVSkillCategory, bool) {
	for _, cvSkillCategory := range cv.Skills {
		if cvSkillCategory.SkillCategoryID == skillCategoryID {
			return cvSkillCategory, true
		}
	}

	return CVSkillCategory{}, false
}
func handleCVSkillCategoryEdit(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.Atoi(r.PathValue("id"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	cv, found := findCV(id)
	if !found {
		http.NotFound(w, r)
		return
	}

	skillCategoryId, err := strconv.Atoi(r.PathValue("skillCategoryId"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	skillCategory, found := findSkillCategory(skillCategoryId)
	if !found {
		http.NotFound(w, r)
		return
	}
	cvSkillCategory, found := findCVSkillCategory(cv, skillCategoryId)
	if !found {
		cvSkillCategory = CVSkillCategory{SkillCategoryID: skillCategoryId}
	}

	page("Edit Education", cvSkillCategoryEdit(cv, skillCategory, cvSkillCategory, "")).Render(r.Context(), w)
}

func handleCVSkillCategoryUpdate(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.Atoi(r.PathValue("id"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	cv, found := findCV(id)
	if !found {
		http.NotFound(w, r)
		return
	}

	skillCategoryId, err := strconv.Atoi(r.PathValue("skillCategoryId"))
	if err != nil {
		http.NotFound(w, r)
		return
	}

	skillCategory, found := findSkillCategory(skillCategoryId)
	if !found {
		http.NotFound(w, r)
		return
	}

	if err := r.ParseForm(); err != nil {
		w.WriteHeader(http.StatusBadRequest)
		page("Edit Education", cvSkillCategoryEdit(cv, skillCategory, CVSkillCategory{SkillCategoryID: skillCategoryId}, "Could not read the form.")).Render(r.Context(), w)
		return
	}

	nextCVSkillCategory := CVSkillCategory{
		SkillCategoryID:   skillCategoryId,
		Skills: parseLines(r.FormValue("skills")),
	}

	next := cv
	next.Skills = append([]CVSkillCategory(nil), cv.Skills...)

	found = false

	for i := range next.Skills {
		if next.Skills[i].SkillCategoryID == skillCategoryId {
			next.Skills[i] = nextCVSkillCategory
			found = true
			break
		}
	}

	if !found {
		next.Skills = append(next.Skills, nextCVSkillCategory)
	}

	nextCVs := append([]CV(nil), cvs...)

	for i := range nextCVs {
		if nextCVs[i].ID == id {
			nextCVs[i] = next
			break
		}
	}

	data, err := json.Marshal(nextCVs)
	if err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		page("Edit Education", cvSkillCategoryEdit(cv, skillCategory, nextCVSkillCategory, "Could not encode the CV Education.")).Render(r.Context(), w)
		return
	}

	if err := writeString("cvs.json", string(data)); err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		page("Edit Education", cvSkillCategoryEdit(cv, skillCategory, nextCVSkillCategory, "Could not save the CV Education.")).Render(r.Context(), w)
		return
	}

	cvs = nextCVs

	http.Redirect(w, r, "/cv/"+strconv.Itoa(id), http.StatusSeeOther)
}

templ cvSkillCategoryEdit(cv CV, skillCategory SkillCategory, value CVSkillCategory, err string) {
	<nav>
		<a href={ "/cv/" + strconv.Itoa(cv.ID) }>Back</a>
		<a href="/cvs">CVS</a>
		<a href="/">Profile</a>
	</nav>
	<h1>{ skillCategory.Name }</h1>
	<form action={ "/cv/" + strconv.Itoa(cv.ID) + "/skills/" + strconv.Itoa(skillCategory.ID) } method="post">
		<label for="skills">Skills</label>
		<br/>
		<textarea name="skills" id="skills" rows="25">{ strings.Join(value.Skills, "\n") }</textarea>
		<br/>
		<button type="submit">Save</button>
	</form>
	if err != "" {
		<p role="alert">{ err }</p>
	}
}

func init() {
	http.HandleFunc("GET /cv/{id}/skills/{skillCategoryId}", handleCVSkillCategoryEdit)
	http.HandleFunc("POST /cv/{id}/skills/{skillCategoryId}", handleCVSkillCategoryUpdate)
}
